APP_NAME="LETS DO!"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Frontend SPA integration
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:3000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL / Neon Database Configuration (Use placeholders only)
DB_CONNECTION=pgsql
DB_HOST=ep-example-neon.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_URL=postgresql://neondb_owner:your_neon_password_here@ep-example-neon.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_URL_UNPOOLED=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email Delivery (Use 'log' for local testing; use 'gmail' for Gmail API / Render; 'smtp' for standard SMTP)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_google_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@letsdo.app"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail API Credentials (when MAIL_MAILER=gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
